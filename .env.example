# --- baza ---
DATABASE_URL=postgresql+psycopg://grunt:grunt@localhost:5433/grunt
# port 5433 celowo, zeby nie kolidowac z lokalnym Postgresem, jesli juz go masz

# Baza w Supabase zamiast lokalnej. Adres z panelu: Connect -> Transaction pooler.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<haslo>@aws-1-<region>.pooler.supabase.com:6543/postgres
# DB_SEARCH_PATH=public,extensions   # PostGIS w Supabase siedzi w extensions
# DB_POOLER=true                     # zbedne przy porcie 6543, wykrywa sie samo
#
# MIGRACJE IDA POLACZENIEM BEZPOSREDNIM, NIE POOLEREM.
# `alembic upgrade head` na porcie 6543 potrafi sie wywrocic w polowie DDL,
# a migracja przerwana w polowie to najgorszy stan, w jakim moze byc schemat:
#   DATABASE_URL=...@db.<ref>.supabase.co:5432/postgres uv run alembic upgrade head

# --- zakres pracy ---
REGION_TERYT=22            # pomorskie. Zmiana na 14 to mazowieckie itd.
REGION_POWIATY=2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2261,2262,2263,2264

# --- scraping ---
SCRAPER_USER_AGENT="GRUNT/0.1 (prywatne narzedzie analityczne; kontakt: TWOJ@EMAIL)"
SCRAPER_DELAY_SECONDS=2.0
SCRAPER_MAX_PAGES_PER_RUN=50
PORTALS_ENABLED=morizon,nieruchomosci_online,otodom,gratka

# --- Apify, opcjonalnie. Bez tokena portale otodom/olx sa po prostu pomijane ---
APIFY_TOKEN=
APIFY_OTODOM_ACTOR=trev0n/otodom-scraper
APIFY_MAX_ITEMS_PER_RUN=300

# --- alerty ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- uslugi lokalne ---
VALHALLA_URL=http://localhost:8002
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- sciezki danych, wszystko wzgledne do katalogu repo ---
DATA_DIR=./data

# --- API ---
# Skad wolno wolac API. Po wdrozeniu dopisz domene frontendu z Vercela.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Token do /api/saved i /api/filters. Pusty znaczy brak kontroli i tak ma byc
# lokalnie. Na publicznym adresie ustaw dlugi losowy ciag:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_WRITE_TOKEN=

# --- scoring ---
SCORING_MODEL_VERSION=v1
AREA_REF_M2=1000           # powierzchnia referencyjna, sekcja 5.2.1
COVERAGE_MIN=0.40          # ponizej tego nie pokazujemy score'u
